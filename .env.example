# Local defaults. Replace these with absolute Google Drive paths if required.
# Run `source .env` from the repository root so $PWD resolves correctly.
RESEARCH_PAPERS_DIR="$PWD/data/papers"
RESEARCH_OUTPUT_DIR="$PWD/data/output"

# Ollama defaults. For LM Studio, use http://localhost:1234/v1 and the model
# identifier displayed by its local server.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=llama3.2

# Optional compatibility and context controls.
LOCAL_LLM_JSON_MODE=true
LOCAL_LLM_MAX_DOCUMENT_CHARS=60000

# Create this in Discord: Server Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/replace/me"

# Keep Airflow state inside the project and use 8081 because Adminer may use
# port 8080. These variables are consumed by `airflow standalone`.
AIRFLOW_HOME="$PWD/.airflow"
AIRFLOW__CORE__DAGS_FOLDER="$PWD/dags"
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__API__PORT=8081
AIRFLOW__API__BASE_URL="http://localhost:8081"
AIRFLOW__CORE__EXECUTION_API_SERVER_URL="http://localhost:8081/execution/"
